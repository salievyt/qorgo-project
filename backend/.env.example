# Django
DJANGO_SECRET_KEY=change-this-to-a-secure-random-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,api.qorgo.app

# Database
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=unified.sqlite3
DB_USER=qorgo
DB_PASSWORD=qorgo
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://admin.qorgo.app,https://operator.qorgo.services

# Firebase (for push notifications)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json
FIREBASE_DATABASE_URL=https://qorgo-xxxxx.firebaseio.com

# SMS Provider (optional)
SMS_PROVIDER=console
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=

# Legacy mobile API SMS / email
TWILIO_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Vercel / managed PostgreSQL (set secrets in Vercel, never commit values)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.qorgo.services,https://qorgo-project-backend.vercel.app
# One-time administrator creation; remove these variables after bootstrap.
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
